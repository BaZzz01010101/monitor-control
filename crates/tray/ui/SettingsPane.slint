import { Switch, VerticalBox } from "std-widgets.slint";

component BackLinkButton inherits Rectangle {
    callback clicked;

    x: 16px;
    y: 16px;
    width: 96px;
    height: 28px;
    background: transparent;
    accessible-label: "Back";
    accessible-role: button;
    accessible-action-default => {
        root.clicked();
    }
    forward-focus: focus-scope;

    Image {
        source: @image-url("../assets/icons/arrow_left_ui.svg");
        x: 0px;
        y: 1px;
        width: 20px;
        height: 20px;
        image-fit: contain;
        colorize: touch.has-hover || focus-scope.has-focus ? #0a365e : #2563eb;
    }

    Text {
        x: 24px;
        y: 0px;
        text: "Back";
        font-size: 15px;
        font-weight: 500;
        color: touch.has-hover || focus-scope.has-focus ? #0a365e : #2563eb;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    focus-scope := FocusScope {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;

        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

export component SettingsPane inherits Rectangle {
    in-out property <bool> autostart-enabled: false;
    callback back;
    callback toggle-autostart;

    background: transparent;

    BackLinkButton {
        clicked => {
            root.back();
        }
    }

    Rectangle {
        x: 16px;
        y: 64px;
        width: parent.width - 32px;
        height: content.preferred-height;
        border-radius: 10px;
        border-width: 1px;
        border-color: #d7dbe1;
        background: #ffffff;

        content := VerticalBox {
            spacing: 10px;
            padding: 16px;
            alignment: start;
            Text {
                text: "General";
                font-size: 18px;
                font-weight: 600;
                color: #161616;
            }

            HorizontalLayout {
                spacing: 12px;

                VerticalBox {
                    spacing: 0px;
                    horizontal-stretch: 1;

                    Text {
                        text: "Start with Windows";
                        font-size: 15px;
                        font-weight: 600;
                        color: #161616;
                    }

                    Text {
                        text: "Launch Dell Controller automatically after you sign in.";
                        font-size: 12px;
                        color: #5b6470;
                        wrap: word-wrap;
                    }
                }

                VerticalLayout {
                    alignment: center;

                    Switch {
                        checked <=> root.autostart-enabled;
                        toggled => {
                            root.toggle-autostart();
                        }
                    }
                }
            }
        }
    }
}
