import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";

export component HeaderCard inherits Rectangle {
    in property <string> monitor-title;
    in property <string> input-summary;
    in property <string> hdr-status;
    callback refresh;

    border-radius: 10px;
    border-width: 1px;
    border-color: #d7dbe1;
    background: #ffffff;

    HorizontalBox {
        spacing: 16px;
        padding: 16px;

        Image {
            source: @image-url("../assets/icons/monitor_ui.png");
            width: 80px;
            height: 48px;
            image-fit: contain;
        }

        VerticalBox {
            spacing: 6px;
            padding: 0px;

            HorizontalBox {
                spacing: 8px;
                padding: 0px;

                Text {
                    text: root.monitor-title;
                    font-size: 16px;
                    font-weight: 600;
                    color: #111111;
                    vertical-alignment: center;
                }

                VerticalBox {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: center;

                    Rectangle {
                        width: 1px;
                        drop-shadow-color: #e0e0e0;
                        drop-shadow-offset-x: 1px;
                        height: 16px;
                        background: #d6d6d6;
                    }
                }

                Text {
                    text: root.input-summary;
                    font-size: 13px;
                    color: #303030;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.hdr-status;
                font-size: 13px;
                color: #1f1f1f;
                vertical-alignment: center;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
        }

        VerticalLayout {
            alignment: center;
            padding-right: 8px;
            Button {
                text: "Refresh";
                icon: @image-url("../assets/icons/refresh_ui.png");
                icon-size: 16px;
                height: 36px;
                min-width: 104px;
                clicked => {
                    root.refresh();
                }
            }
        }
    }
}
