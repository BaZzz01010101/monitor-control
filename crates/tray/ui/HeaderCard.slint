import { HorizontalBox, VerticalBox } from "std-widgets.slint";
import { AppSwitch } from "AppSwitch.slint";

component IconActionButton inherits Rectangle {
    in property <string> accessible-name;
    in property <image> icon;
    callback clicked;

    width: 40px;
    height: 40px;
    border-radius: 8px;
    border-width: 1px;
    border-color: focus-scope.has-focus ? #8ab2ff : #d0d6dd;
    background: touch.has-hover || focus-scope.has-focus ? #f7fbff : #ffffff;
    accessible-label: root.accessible-name;
    accessible-role: button;
    accessible-action-default => {
        root.clicked();
    }
    forward-focus: focus-scope;

    Image {
        source: root.icon;
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    focus-scope := FocusScope {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;

        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }

            reject
        }
    }
}

export component HeaderCard inherits Rectangle {
    in property <string> monitor-title;
    in property <string> input-summary;
    in property <string> hdr-status;
    in property <bool> hdr-enabled;
    in property <bool> hdr-toggle-enabled;
    in property <bool> hdr-pending;
    callback open-settings;
    callback toggle-hdr(bool);

    border-radius: 10px;
    border-width: 1px;
    border-color: #d7dbe1;
    background: #ffffff;

    HorizontalBox {
        spacing: 16px;
        padding: 16px;

        Image {
            source: @image-url("../assets/icons/monitor_ui.png");
            width: 80px;
            height: 48px;
            image-fit: contain;
        }

        VerticalBox {
            spacing: 6px;
            padding: 0px;

            HorizontalBox {
                spacing: 8px;
                padding: 0px;

                Text {
                    text: root.monitor-title;
                    font-size: 16px;
                    font-weight: 600;
                    color: #111111;
                    vertical-alignment: center;
                }

                VerticalBox {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: center;

                    Rectangle {
                        width: 1px;
                        drop-shadow-color: #e0e0e0;
                        drop-shadow-offset-x: 1px;
                        height: 16px;
                        background: #d6d6d6;
                    }
                }

                Text {
                    text: root.input-summary;
                    font-size: 13px;
                    color: #303030;
                    vertical-alignment: center;
                }
            }

            HorizontalBox {
                spacing: 8px;
                padding: 0px;
                alignment: start;

                Text {
                    text: root.hdr-status;
                    font-size: 13px;
                    color: #1f1f1f;
                    vertical-alignment: center;
                }

                AppSwitch {
                    checked: root.hdr-enabled;
                    enabled: root.hdr-toggle-enabled;
                    pending: root.hdr-pending;
                    accessible-name: "Windows HDR";
                    toggled(enabled) => {
                        root.toggle-hdr(enabled);
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
        }

        VerticalLayout {
            alignment: center;
            padding-right: 8px;

            IconActionButton {
                accessible-name: "Settings";
                icon: @image-url("../assets/icons/gear_ui.svg");
                clicked => {
                    root.open-settings();
                }
            }
        }
    }
}
