import { VerticalBox } from "std-widgets.slint";
import { HeaderCard } from "HeaderCard.slint";
import { PictureCard } from "PictureCard.slint";
import { InputCard } from "InputCard.slint";
import { SettingsPane } from "SettingsPane.slint";
import { StatusBar } from "StatusBar.slint";

component CardTitle inherits Text {
    font-size: 18px;
    font-weight: 600;
    color: #161616;
}

export component MainWindow inherits Window {
    title: "Dell Controller";
    width: 570px;
    height: 480px;
    background: #f7fafd;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 14px;

    in property <bool> settings-open: false;
    in property <string> monitor-title: "No DDC/CI monitor detected";
    in property <string> input-summary: "Input";
    in property <string> hdr-status: "Windows HDR: unavailable";
    in property <bool> hdr-enabled: false;
    in property <bool> hdr-toggle-enabled: false;
    in-out property <int> brightness-value: 0;
    in property <int> brightness-maximum: 100;
    in property <bool> brightness-enabled: false;
    in-out property <int> contrast-value: 0;
    in property <int> contrast-maximum: 100;
    in property <bool> contrast-enabled: false;
    in property <int> selected-input: 0;
    in property <bool> input-enabled: false;
    in-out property <bool> autostart-enabled: false;
    in-out property <string> tb-shortcut: "None";
    in property <string> tb-shortcut-preview: "";
    in property <bool> tb-shortcut-awaiting-final-key: false;
    in property <string> tb-shortcut-error-text: "";
    in-out property <string> dp-shortcut: "None";
    in property <string> dp-shortcut-preview: "";
    in property <bool> dp-shortcut-awaiting-final-key: false;
    in property <string> dp-shortcut-error-text: "";
    in-out property <string> hdmi-shortcut: "None";
    in property <string> hdmi-shortcut-preview: "";
    in property <bool> hdmi-shortcut-awaiting-final-key: false;
    in property <string> hdmi-shortcut-error-text: "";
    in property <string> status-text: "Ready";

    callback open-settings();
    callback close-settings();
    callback toggle-autostart();
    callback toggle-hdr(bool);
    callback deactivate-tb-shortcut-capture();
    callback preview-tb-shortcut(string);
    callback commit-tb-shortcut(string);
    callback clear-tb-shortcut();
    callback deactivate-dp-shortcut-capture();
    callback preview-dp-shortcut(string);
    callback commit-dp-shortcut(string);
    callback clear-dp-shortcut();
    callback deactivate-hdmi-shortcut-capture();
    callback preview-hdmi-shortcut(string);
    callback commit-hdmi-shortcut(string);
    callback clear-hdmi-shortcut();
    callback normalize-shortcut-key(string) -> string;
    callback brightness-preview(int);
    callback brightness-commit(int);
    callback contrast-preview(int);
    callback contrast-commit(int);
    callback select-input(int);

    if (!root.settings-open) : VerticalBox {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        spacing: 14px;
        padding: 16px;

        VerticalBox {
            spacing: 14px;
            padding: 0px;

            HeaderCard {
                monitor-title: root.monitor-title;
                input-summary: root.input-summary;
                hdr-status: root.hdr-status;
                hdr-enabled: root.hdr-enabled;
                hdr-toggle-enabled: root.hdr-toggle-enabled;
                open-settings => {
                    root.open-settings();
                }
                toggle-hdr(enabled) => {
                    root.toggle-hdr(enabled);
                }
            }

            HorizontalLayout {
                padding-left: 10px;

                CardTitle {
                    text: "Picture";
                }
            }

            PictureCard {
                brightness-value <=> root.brightness-value;
                brightness-maximum: root.brightness-maximum;
                brightness-enabled: root.brightness-enabled;
                contrast-value <=> root.contrast-value;
                contrast-maximum: root.contrast-maximum;
                contrast-enabled: root.contrast-enabled;
                brightness-preview(value) => {
                    root.brightness-preview(value);
                }
                brightness-commit(value) => {
                    root.brightness-commit(value);
                }
                contrast-preview(value) => {
                    root.contrast-preview(value);
                }
                contrast-commit(value) => {
                    root.contrast-commit(value);
                }
            }

            HorizontalLayout {
                padding-left: 10px;

                CardTitle {
                    text: "KVM / Input";
                }
            }

            InputCard {
                selected-input: root.selected-input;
                enabled: root.input-enabled;
                select-input(value) => {
                    root.select-input(value);
                }
            }

            Rectangle {
                vertical-stretch: 1;
                background: transparent;
            }
        }

        StatusBar {
            text: root.status-text;
        }
    }

    if (root.settings-open) : SettingsPane {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        autostart-enabled <=> root.autostart-enabled;
        tb-shortcut <=> root.tb-shortcut;
        tb-shortcut-preview: root.tb-shortcut-preview;
        tb-shortcut-awaiting-final-key: root.tb-shortcut-awaiting-final-key;
        tb-shortcut-error-text: root.tb-shortcut-error-text;
        dp-shortcut <=> root.dp-shortcut;
        dp-shortcut-preview: root.dp-shortcut-preview;
        dp-shortcut-awaiting-final-key: root.dp-shortcut-awaiting-final-key;
        dp-shortcut-error-text: root.dp-shortcut-error-text;
        hdmi-shortcut <=> root.hdmi-shortcut;
        hdmi-shortcut-preview: root.hdmi-shortcut-preview;
        hdmi-shortcut-awaiting-final-key: root.hdmi-shortcut-awaiting-final-key;
        hdmi-shortcut-error-text: root.hdmi-shortcut-error-text;
        back => {
            root.close-settings();
        }
        toggle-autostart => {
            root.toggle-autostart();
        }
        deactivate-tb-shortcut-capture => {
            root.deactivate-tb-shortcut-capture();
        }
        preview-tb-shortcut(text) => {
            root.preview-tb-shortcut(text);
        }
        commit-tb-shortcut(text) => {
            root.commit-tb-shortcut(text);
        }
        clear-tb-shortcut => {
            root.clear-tb-shortcut();
        }
        deactivate-dp-shortcut-capture => {
            root.deactivate-dp-shortcut-capture();
        }
        preview-dp-shortcut(text) => {
            root.preview-dp-shortcut(text);
        }
        commit-dp-shortcut(text) => {
            root.commit-dp-shortcut(text);
        }
        clear-dp-shortcut => {
            root.clear-dp-shortcut();
        }
        deactivate-hdmi-shortcut-capture => {
            root.deactivate-hdmi-shortcut-capture();
        }
        preview-hdmi-shortcut(text) => {
            root.preview-hdmi-shortcut(text);
        }
        commit-hdmi-shortcut(text) => {
            root.commit-hdmi-shortcut(text);
        }
        clear-hdmi-shortcut => {
            root.clear-hdmi-shortcut();
        }
        normalize-shortcut-key(text) => {
            return root.normalize-shortcut-key(text);
        }
    }
}
