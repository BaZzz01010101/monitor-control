import { HorizontalBox, Slider } from "std-widgets.slint";
import { ValueEditor } from "ValueEditor.slint";

export component ValueControl inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in-out property <int> current-value: 0;
    in property <int> maximum-value: 100;
    in property <bool> enabled: true;

    callback preview(int);
    callback commit(int);

    background: transparent;
    min-height: 44px;

    HorizontalBox {
        spacing: 12px;
        padding: 0px;
        alignment: center;

        Image {
            source: root.icon;
            width: 24px;
            height: 24px;
            image-fit: contain;
            opacity: root.enabled ? 1 : 0.45;
        }

        Text {
            width: 110px;
            text: root.label;
            vertical-alignment: center;
            color: root.enabled ? #1a1a1a : #8b8b8b;
        }

        slider := Slider {
            enabled: root.enabled;
            minimum: 0;
            maximum: root.maximum-value;
            value: root.current-value;
            changed => {
                root.current-value = self.value;
                root.preview(root.current-value);
            }
            released => { root.commit(root.current-value); }
        }

        ValueEditor {
            current-value <=> root.current-value;
            minimum: 0;
            maximum: root.maximum-value;
            enabled: root.enabled;
            preview(value) => { root.preview(value); }
            commit(value) => { root.commit(value); }
        }
    }
}
