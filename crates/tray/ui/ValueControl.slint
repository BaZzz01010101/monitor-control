import { Slider } from "std-widgets.slint";
import { ValueEditor } from "ValueEditor.slint";

export component ValueControl inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in-out property <int> current-value: 0;
    in property <int> maximum-value: 100;
    in property <bool> enabled: true;

    callback preview(int);
    callback commit(int);

    background: transparent;
    min-height: 52px;

    changed current-value => {
        if slider.value != root.current-value {
            slider.value = root.current-value;
        }
    }

    HorizontalLayout {
        spacing: 12px;
        padding-left: 10px;
        padding-right: 10px;

        Rectangle {
            width: 120px;
            background: transparent;

            HorizontalLayout {
                spacing: 15px;
                padding: 0px;

                VerticalLayout {
                    alignment: center;
                    padding-top: 2px;

                    Image {
                        source: root.icon;
                        width: 18px;
                        height: 18px;
                        image-fit: contain;
                        opacity: root.enabled ? 1 : 0.45;
                    }
                }

                Text {
                    horizontal-stretch: 0;
                    text: root.label;
                    font-size: 16px;
                    vertical-alignment: center;
                    color: root.enabled ? #1a1a1a : #8b8b8b;
                }
            }
        }

        VerticalLayout {
            alignment: start;

            slider := Slider {
                horizontal-stretch: 1;
                min-width: 140px;
                height: 54px;
                enabled: root.enabled;
                minimum: 0;
                maximum: root.maximum-value;
                value: root.current-value;
                changed => {
                    root.current-value = self.value;
                    root.preview(root.current-value);
                }
                released => {
                    root.commit(root.current-value);
                }
            }
        }

        VerticalLayout {
            alignment: center;

            ValueEditor {
                width: 84px;
                current-value <=> root.current-value;
                minimum: 0;
                maximum: root.maximum-value;
                enabled: root.enabled;
                preview(value) => {
                    root.preview(value);
                }
                commit(value) => {
                    root.commit(value);
                }
            }
        }
    }
}
